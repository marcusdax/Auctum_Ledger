```ts
export interface Problem {
  type: string;
  title: string;
  status: number;
  code: string;
  detail?: string;
  errors?: Array<{ field: string; code: string; message: string }>;
  traceId?: string;
}

export function problem(status: number, code: string, detail?: string, errors?: Array<{ field: string; code: string; message: string }>): Problem {
  return {
    type: `https://api.greensheet.io/problems/${code}`,
    title: code,
    status,
    code,
    detail,
    errors,
    traceId: crypto.randomUUID?.(),
  };
}
```

