- [ ] **Step 4: Create server registry and app skeleton**

Create `app/server/db/index.ts`:

```ts
import { Pool } from 'pg';
import { Kafka } from 'kafkajs';
import { createClient } from 'redis';

export const db = {
  pg: new Pool({ connectionString: process.env.DATABASE_URL }),
  redis: createClient({ url: process.env.REDIS_URL }),
  kafka: new Kafka({ brokers: (process.env.KAFKA_BROKERS ?? 'localhost:9092').split(',') }),
  outboxQueue: [] as Array<{ topic: string; key?: string; value: unknown }>,
};
```

Create `app/server/app.ts`:

```ts
import express from 'express';
import { createRouter } from './routes/index.js';
import { problem } from './lib/problem.js';

export function createApp(): express.Express {
  const app = express();
  app.use(express.json({ limit: '256kb' }));

  app.get('/health', (_req, res) => res.json({ status: 'ok' }));
  app.use('/api/v1', createRouter());
  app.use((_req, res) => problem(404, 'GS-GEN-1005', 'Resource not found'));
  return app;
}
```

Create `app/server/routes/index.ts`:

```ts
import { Router } from 'express';
export function createRouter(): Router {
  return Router();
}
```

Modify `app/server/index.ts` to import `createApp` from `./app.ts` and call it (the existing `createApp` should be moved or renamed). Keep `/api/v1/chat` router mounted in `createRouter`.

