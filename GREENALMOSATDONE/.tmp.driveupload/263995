import { describe, it, expect } from 'vitest';
import { Pool } from 'pg';

describe('migrations', () => {
  it('creates required tables', async () => {
    const pool = new Pool({ connectionString: process.env.DATABASE_URL });
    const res = await pool.query(`
      SELECT table_name FROM information_schema.tables
      WHERE table_schema = 'public' AND table_name IN ('roasters','catalog_lots','campaigns')
      ORDER BY table_name
    `);
    const names = res.rows.map(r => r.table_name);
    expect(names).toContain('roasters');
    expect(names).toContain('catalog_lots');
    expect(names).toContain('campaigns');
  });
});
